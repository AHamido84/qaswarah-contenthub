# ─── Data source ────────────────────────────────────────────────
# "google" = live Google Sheet (production). "demo" = in-memory sample data (no credentials needed).
DATA_SOURCE=google
SPREADSHEET_ID=1KE3W0hCZnX4G14WgHMKJtJ-ZwBMqtIBsafG8RrTlxnc

# Service account with Editor access on the spreadsheet (share the sheet with its client_email).
GOOGLE_SERVICE_ACCOUNT_EMAIL=content-hub@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n sequences, wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Auth ───────────────────────────────────────────────────────
# "google" = Google sign-in (production). "demo" = pick a role on the sign-in page (local only).
AUTH_MODE=google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated allowlists. Admins can create companies and apply data fixes.
# Editors can add/edit ideas. Viewers are read-only. Anyone not listed is refused.
ADMIN_EMAILS=mr.ahamido@gmail.com
EDITOR_EMAILS=
VIEWER_EMAILS=
# Optionally allow a whole Google Workspace domain as viewers, e.g. qaswarah.com
VIEWER_DOMAIN=

# Seconds to cache sheet reads (Sheets API quota: 60 reads/min/user).
SHEET_CACHE_TTL=15
